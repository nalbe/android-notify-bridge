<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="@string/app_name"
        android:allowBackup="false">

        <!-- Notification bridge: feeds chgd over the abstract "chgd_noty"
             socket. Works on ANY build type (the daemon's logdr fallback
             only fires on debuggable builds). Only the system may bind.
             Standalone headless service - install alongside the daemon,
             grant notification access once. -->
        <service
            android:name=".LedNotificationListenerService"
            android:label="LED notification bridge"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Reload trigger: am broadcast -a com.bastet.lednls.RELOAD_CONFIG
             (or any writer of /data/local/tmp/lednls_bridge.json) applies
             the fresh rule set without touching the running service. -->
        <receiver
            android:name=".ReloadReceiver"
            android:label="LED bridge config reload"
            android:exported="true">
            <intent-filter>
                <action android:name="com.bastet.lednls.RELOAD_CONFIG" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
