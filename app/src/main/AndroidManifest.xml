<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false">

        <!-- Notification bridge: feeds any consumer over an abstract
             Unix socket. Only the system may bind. Standalone headless
             service - install alongside your consumer, grant notification
             access once. -->
        <service
            android:name=".NotificationBridgeService"
            android:label="Notification bridge"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Reload trigger: am broadcast -a com.bastet.notybridge.RELOAD_CONFIG
             (or any writer of /data/local/tmp/notybridge.json) applies
             the fresh rule set without touching the running service. This
             is the only way to re-read the config - there is no polling. -->
        <receiver
            android:name=".ReloadReceiver"
            android:label="NotyBridge config reload"
            android:exported="true">
            <intent-filter>
                <action android:name="com.bastet.notybridge.RELOAD_CONFIG" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
